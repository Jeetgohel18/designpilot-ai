# Copy this file to .env.local and fill in what you want. Everything is OPTIONAL:
# the app works without any of these, and clearly says what's switched off.

# AI analysis + assistant via Google Gemini (free tier available: https://aistudio.google.com/apikey)
# Server-only: never prefix with NEXT_PUBLIC_. Do NOT enable billing unless you intend to pay.
GEMINI_API_KEY=
# Optional. Default: gemini-3.5-flash-lite, falling back to gemini-3.1-flash-lite only on "model not found".
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional developer-only diagnostics token (16+ random characters). Enables detailed /api/ai-status output.
# AI_STATUS_TOKEN=

# Live font popularity/metadata (free): Google Cloud Console → enable "Web Fonts Developer API" → create API key
GOOGLE_FONTS_API_KEY=

# Live web results for the References tab (https://brave.com/search/api/ — has a free tier)
BRAVE_SEARCH_API_KEY=

# Live photo previews with attribution (https://unsplash.com/developers — free demo tier: 50 requests/hour)
UNSPLASH_ACCESS_KEY=

# Your public site address (used in share links + social cards)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where share links are stored on disk (default: ./.data). Use a persistent volume in production.
# SHARE_DATA_DIR=
